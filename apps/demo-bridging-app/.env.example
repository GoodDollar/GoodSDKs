# Optional public RPC overrides. Defaults work without this file.
# All VITE_* values are exposed to the browser. Never put secrets here.
VITE_CELO_RPC_URL=https://forno.celo.org
VITE_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
VITE_FUSE_RPC_URL=https://rpc.fuse.io
VITE_XDC_RPC_URL=https://rpc.xdcrpc.com

# Optional public Reown project ID. Blank uses browser-wallet connection.
# No Reown account is needed for read-only QA.
VITE_REOWN_PROJECT_ID=
