{
  "name": "@goodsdks/savings-widget",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "yarn build-savings",
    "dev": "tsc --watch",
    "build-savings": "tsup --config tsup.config.savings.ts",
    "bump-savings": "yarn version patch && yarn build-savings && git add package.json && git commit -m \"version bump\""
  },
  "main": "./dist/index.global.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@goodsdks/savings-sdk": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "latest"
  },
  "dependencies": {
    "lit": "^3.1.0",
    "viem": "latest"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoodDollar/GoodSDKs.git",
    "directory": "packages/savings-widget"
  },
  "publishConfig": {
    "access": "public"
  }
}
