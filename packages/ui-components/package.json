{
  "name": "@goodsdks/ui-components",
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "build": "yarn build-claim",
    "dev": "tsc --watch",
    "build-claim": "tsup --config tsup.config.claim.ts",
    "bump-claim": "yarn version patch && yarn build-claim && git add package.json && git commit -m \"version bump\""
  },
  "main": "./dist/index.global.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@goodsdks/citizen-sdk": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "latest",
    "viem": "latest"
  },
  "dependencies": {
    "@reown/appkit": "^1.7.2",
    "@reown/appkit-adapter-ethers": "^1.7.2",
    "ethers": "6.13.5",
    "lit": "^3.2.1"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoodDollar/GoodSDKs.git",
    "directory": "packages/ui-components"
  },
  "publishConfig": {
    "access": "public"
  }
}
